# Copy to .env and fill in.

# Postgres connection string (or swap provider to "sqlite" in schema.prisma for a zero-setup demo)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/claims_engine?schema=public"

# If unset, OpenAiService automatically falls back to a deterministic mock evaluator
# so the API is runnable/demoable without incurring cost or requiring a key.
OPENAI_API_KEY=

# Which OpenAI model to use for assessment
OPENAI_MODEL=gpt-4o-mini

PORT=3001
